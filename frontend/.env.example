# Base URL of the Django API. Leave empty in development: Vite proxies /api to the backend.
# Set it when the frontend is hosted separately from the API, e.g. https://kbfinance-api.onrender.com
VITE_API_BASE_URL=

# Dev only: where the Vite dev server proxies /api (default http://127.0.0.1:8000)
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
