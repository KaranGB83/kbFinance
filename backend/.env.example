# --- Django ---
SECRET_KEY=replace-with-secret-key
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed for the Django admin login over HTTPS
CSRF_TRUSTED_ORIGINS=http://localhost
# Origin(s) of the React frontend allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Leave POSTGRES_DB empty/unset to use a local SQLite file (db.sqlite3) in development.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Gunicorn ---
WEB_CONCURRENCY=2
